# Local development — copy to .env and fill in values.
# Production split:
#   GitHub Secrets → VITE_RENDER_URL only (frontend build)
#   Render         → everything else (backend)

# --- Backend (Render in production) ---
DATABASE_URL=
SESSION_SECRET=
FRONTEND_URL=
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# --- Frontend (GitHub Secrets in production) ---
VITE_RENDER_URL=
